fragment = "Shaders/ShaderCode/2DR_Fragment.fs"
vertex = "Shaders/ShaderCode/2DR_Vertex.vs"fragment = "Shaders/ShaderCode/SolidTexture.fs"
vertex = "Shaders/ShaderCode/FSQ.vs"fragment = "Shaders/ShaderCode/Fragment.fs"
vertex = "Shaders/ShaderCode/Vertex.vs"fragment = "Shaders/ShaderCode/Fragment.fs"
vertex = "Shaders/ShaderCode/VertexSkinned.vs"
skeletal = "true"#if GL_ES
precision mediump float;
#endif

out vec4 FragColor;

in vec2 TexCoord;
  
uniform sampler2D sprite;

void main()
{
    FragColor = texture(sprite, TexCoord);
	if (FragColor.a < 0.5)
		discard;
}out vec2 TexCoord;

const vec2 g_quadVerts[4] = vec2[4]( vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(-0.5, 0.5), vec2(0.5, 0.5) );
const vec2 g_quadTexCoords[4] = vec2[4]( vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0) );

uniform mat4 transform;

void main()
{
    gl_Position = transform * vec4(g_quadVerts[gl_VertexID], 0.0, 1.0);
    TexCoord = g_quadTexCoords[gl_VertexID];
}out vec2 TexCoord;

const vec2 g_quadVerts[4] = vec2[4]( vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0) );
const vec2 g_quadTexCoords[4] = vec2[4]( vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0) );

void main()
{
    gl_Position = vec4(g_quadVerts[gl_VertexID], 0.0, 1.0);
    TexCoord = g_quadTexCoords[gl_VertexID];
}#if GL_ES
precision mediump float;
#endif
out vec4 FragColor;

in vec2 TexCoord;
  
uniform sampler2D sprite;

void main()
{
    FragColor = texture(sprite, TexCoord);
	if (FragColor.a < 0.5)
		discard;
}layout (location = 0) in vec3 aPos;
layout (location = 2) in vec2 aTexCoord;

out vec2 TexCoord;

void main()
{
    gl_Position = vec4(aPos, 1.0);
    TexCoord = aTexCoord;
}#if GL_ES
precision mediump float;
#endif
out vec4 FragColor;

in vec2 TexCoord;
  
uniform sampler2D tex;

void main()
{
    FragColor = texture(tex, TexCoord);
	if (FragColor.a < 0.5)
		discard;
}layout (location = 0) in vec3 aPosition;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aUV;

out vec2 TexCoord;
out vec3 Normal;

uniform mat4 u_mvp;

void main()
{
    gl_Position = u_mvp * vec4(aPosition, 1.0);
    TexCoord = aUV;
	Normal = aNormal;
}layout (location = 0) in vec3 aPosition;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aUV;
layout (location = 3) in uvec4 aJoint;
layout (location = 4) in vec4 aWeight;

out vec2 TexCoord;
out vec3 Normal;

uniform mat4 u_mvp;

layout(std140) uniform SkeletonData {
    mat4 u_boneMatrices[64]; 
};

void main()
{
	vec4 weight = aWeight;
	
	mat4 skinMatrix = weight.x * u_boneMatrices[aJoint.x] +
					  weight.y * u_boneMatrices[aJoint.y] + 
					  weight.z * u_boneMatrices[aJoint.z] +
					  weight.w * u_boneMatrices[aJoint.w];


    gl_Position = u_mvp * skinMatrix * vec4(aPosition, 1.0);
    TexCoord = aUV;
	
	// Apply skin transformation to normals
	Normal = mat3(skinMatrix) * aNormal;
}âPNG
